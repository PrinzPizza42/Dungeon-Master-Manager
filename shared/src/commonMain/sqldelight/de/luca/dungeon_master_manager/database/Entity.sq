CREATE TABLE IF NOT EXISTS Entity (
    id TEXT PRIMARY KEY,
    name TEXT NOT NULL,
    type TEXT NOT NULL,
    color TEXT,
    notesFilePath TEXT
);

selectAll:
SELECT * FROM Entity;

selectById:
SELECT * FROM Entity WHERE id = ?;

selectByType:
SELECT * FROM Entity WHERE type = ?;

insertEntity:
INSERT INTO Entity(id, name, type, color, notesFilePath)
VALUES (?, ?, ?, ?, ?);

updateEntity:
UPDATE Entity
SET name = ?, type = ?, color = ?, notesFilePath = ?
WHERE id = ?;

deleteEntity:
DELETE FROM Entity WHERE id = ?;
